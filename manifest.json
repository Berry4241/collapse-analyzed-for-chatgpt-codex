{
  "manifest_version": 3,
  "name": "Collapse Analyzed for ChatGPT & Codex",
  "short_name": "Collapse Analyzed",
  "version": "1.6.0",
  "minimum_chrome_version": "110",
  "description": "Collapse expanded Analyzed panels in ChatGPT and Codex with responsive, verified batches. Runs locally when clicked. Not affiliated with OpenAI.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Collapse currently expanded Analyzed sections"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Collapse currently expanded Analyzed sections"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
